# Generate a private random token before enabling the service.
CB_GATEWAY_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
CB_GATEWAY_PROVIDERS=workbuddy
CB_GATEWAY_AUTO_IMPORT=0
CB_GATEWAY_AUTO_CHECKIN=0
CB_GATEWAY_KEEPALIVE=0
CB_GATEWAY_ALLOW_UNAUTHENTICATED_API=0
CB_GATEWAY_DB_PATH=/var/lib/buddy2api/gateway.db
CB_AUTH_DIR=/var/lib/buddy2api/empty-auth
CB_GATEWAY_LOG_RETENTION_DAYS=14
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
HOME=/var/lib/buddy2api

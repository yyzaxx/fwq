[Unit]
Description=WorkBuddy Daily 控制台（Web 面板）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/workbuddy
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
Environment=PANEL_PORT=8600
Environment=PANEL_BIND=0.0.0.0
ExecStart=/usr/bin/python3 /opt/workbuddy/panel.py
Restart=always
RestartSec=3
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
